<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XfaToAcroForm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GdPicture.API" Version="14.4.9" />
    <!-- Reads the XFA packets (GdPicture can detect and remove XFA, but not read it). Apache-2.0. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
